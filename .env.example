DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/investos?retryWrites=true&w=majority"

# ── Auth ──────────────────────────────────────────────────────────────
# HMAC key for signing JWTs. At least 32 characters. Rotate to invalidate all sessions.
JWT_SECRET=""
# Set these two, then run `npm run db:seed` to create / update the user.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""

# ── OpenAI — used by the Telegram expense bot parser ─────────────────
OPENAI_API_KEY=""
# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

# ── Telegram bot ──────────────────────────────────────────────────────
# Get from @BotFather.
TELEGRAM_BOT_TOKEN=""
# Numeric chat.id of the only allowed sender. Find via:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getUpdates"
TELEGRAM_ALLOWED_CHAT_ID=""
#
# NOTE: the Telegram webhook no longer uses a TELEGRAM_WEBHOOK_SECRET env var.
# Create an API key at /settings/keys and pass THAT raw key as the `secret_token`
# parameter on Telegram's setWebhook call. The webhook verifies it against the
# ApiKey table so you can rotate or revoke without redeploying.
